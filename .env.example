# 한국투자증권(KIS) Open API 모의투자 설정 — 이 파일을 .env로 복사해서 값을 채우세요.
# .env는 .gitignore로 제외됩니다. mock 모드는 이 파일 없이 실행됩니다.
VPS_KIS_APP_KEY=
VPS_KIS_APP_SECRET=
# 계좌번호 8자리-상품코드 2자리 (상품코드를 생략하면 선물옵션 03)
KIS_ACCOUNT_NO=00000000-03
# KOSPI200 선물 종목코드 — 만기마다 바꿔야 합니다 (예: 2026년 12월물 A01612)
KIS_INST_CODE=A01612
# 기본값은 모의투자 서버
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443
